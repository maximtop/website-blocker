# Chrome Web Store credentials for the local make chrome_* commands.
# Copy to .env (gitignored) and fill in the values. Never commit .env.
# The same values are stored as GitHub Actions secrets and variables for
# .github/workflows/deploy-chrome-store.yml; see README.md.

# Item ID from the Chrome Web Store Developer Dashboard item URL.
CHROME_APP_ID=enffllmgjpgoifnfeljkfhpedcadnpbj

# OAuth 2.0 client of a Google Cloud project with the Chrome Web Store API
# enabled, and a refresh token granted for the
# https://www.googleapis.com/auth/chromewebstore scope.
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Publisher ID from the Developer Dashboard account page.
CHROME_PUBLISHER_ID=

# Firefox AMO: use the slug assigned in Developer Hub after the first submission.
FIREFOX_AMO_ID=
FIREFOX_CLIENT_ID=
FIREFOX_CLIENT_SECRET=
